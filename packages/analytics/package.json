{
  "name": "@vzb/analytics",
  "version": "0.2.0",
  "description": "Shared Umami analytics layer for the Vzdělání budoucnosti sites.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --outDir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publish-dist": "node scripts/publish-dist.mjs"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
